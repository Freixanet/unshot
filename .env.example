# ---------------------------------------------------------------------------
# unshot configuration. Copy to .env and fill in. Model names are NOT
# hard-coded anywhere in the code: put whatever your account has access to.
# ---------------------------------------------------------------------------

# Step 1 - vision model that analyses the photo and writes the 2 prompts
PROMPT_PROVIDER=gemini            # gemini | openai
PROMPT_MODEL=                     # e.g. a Gemini or OpenAI vision model id
PROMPT_THINKING=                  # optional; Gemini thinking_level or OpenAI reasoning effort (e.g. LOW)

# Step 2 - image model that edits the original photo into each scene (OpenAI Images Edit API)
IMAGE_MODEL=                      # e.g. a gpt-image model id
IMAGE_QUALITY=                    # optional, e.g. medium | high (empty = provider default)
IMAGE_SIZE=1024x1280              # optional, 4:5 vertical; empty = provider default
IMAGE_INPUT_FIDELITY=             # optional, e.g. high (better product preservation if supported)

# API keys (only the ones your providers need)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Telegram bot (only for `unshot-bot`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=           # optional comma-separated Telegram user ids; empty = anyone
